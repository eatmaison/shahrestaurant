{
  "manifest_version": 3,
  "name": "Shah Stock — Sligro Price Preview",
  "version": "0.1.0",
  "description": "Read approved Sligro product prices for manual review in Shah Stock. No orders or login data.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.sligro.nl/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "content_scripts": [{
    "matches": ["https://shahrestaurant.nl/admin*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
